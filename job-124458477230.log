2026-10-31T05:52:13.7474525Z ##[group] Inputs
2026-10-31T05:52:13.7477940Z   build: rc=0
bash -euo pipefail > /tmp/l8-build.log 2>&1 <<'EOF' || rc=$?
# the builder checks out without submodules: fm1-base (base/) and its felucca-bsp (base/bsp/), at the
# commits this one links (.gitmodules: the forks)
git submodule update --init --recursive
# the fonts' OpenType features (base/tools/gen_font.py): Pillow's raqm, which loads the system's FriBiDi
# (as LOOM-8's own release.yml)
sudo apt-get install -y -qq libfribidi0
python3 -c "from PIL import features; assert features.check('raqm'), 'Pillow without raqm'"
if [[ "$GITHUB_REF" == refs/tags/loom8-v* ]]; then rel=(--release "${GITHUB_REF_NAME#loom8-v}"); else rel=(); fi
BOARD=smk37 ./build.sh "${rel[@]}"
BOARD=smk37 MODEL=elite ./build.sh "${rel[@]}"
BOARD=smk37 MODEL=mke ./build.sh "${rel[@]}"
# the download: the three packages, the installer and the backup tool, and a note on where to start
mkdir -p build/loom8
cp app/build/loom-smk37*.fwsc base/tools/fm1_install.py tools/smk37_backup.py tools/START-HERE.txt \
  build/loom8/
EOF
cat /tmp/l8-build.log
# the sizes as a note on the run's page (the image against the SMK-37's app slot, 619,520 B; the factory
# samples), readable where the full log isn't
grep -E "image [0-9]+ B; RAM|^samples: " /tmp/l8-build.log | while read -r l; do
  echo "::notice title=Size::$l"
done || true
if [ "$rc" != 0 ]; then
  echo "::error title=Build failed::$(tail -n 60 /tmp/l8-build.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

2026-10-31T05:52:13.7481451Z   packages: build/loom8/*
2026-10-31T05:52:13.7482848Z   test: rc=0
bash -euo pipefail > /tmp/l8-test.log 2>&1 <<'EOF' || rc=$?
BOARD=smk37 ./build.sh --host
mkdir -p /tmp/l8-scenarios
for s in tests/scenarios_smk37/*.xy; do app/build/host/loom-smk37_host "$s" /tmp/l8-scenarios; done
cc -std=c99 -Wall -Wno-unused-function -o /tmp/smk_daw_test tests/smk_daw_test.c
/tmp/smk_daw_test
python3 tests/smk37_backup_test.py
EOF
cat /tmp/l8-test.log
if [ "$rc" != 0 ]; then
  echo "::error title=Tests failed::$(tail -n 60 /tmp/l8-test.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

