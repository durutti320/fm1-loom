2026-11-20T11:50:20.2196433Z ##[group] Inputs
2026-11-20T11:50:20.2203540Z   build: rc=0
bash -euo pipefail > /tmp/sp-build.log 2>&1 <<'EOF' || rc=$?
# the builder checks out without submodules: fm1-base (base/) and its felucca-bsp (base/bsp/)
git submodule update --init --recursive
sudo apt-get install -y -qq libfribidi0
python3 -c "from PIL import features; assert features.check('raqm'), 'Pillow without raqm'"
./build.sh
python3 tools/elf_funcs.py "$(ls app/build/*.elf | head -1)" || true
mkdir -p build/sprout
cp app/build/*.fwsc base/tools/fm1_install.py base/tools/fm1ports.py base/tools/fm1_backup.py build/sprout/
cp app/build/*-res.bin build/sprout/ 2>/dev/null || true
(cd build/sprout && PYTHONDONTWRITEBYTECODE=1 python3 fm1_install.py --help > /dev/null && rm -rf __pycache__)
EOF
cat /tmp/sp-build.log
grep -E "image [0-9]+ B; RAM|^samples: |^font G" /tmp/sp-build.log | while read -r l; do
  echo "::notice title=Size::$l"
done || true
if [ "$rc" != 0 ]; then
  echo "::error title=Build failed::$(tail -n 60 /tmp/sp-build.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

2026-11-20T11:50:20.2210800Z   packages: build/sprout/*
2026-11-20T11:50:20.2217291Z   test: rc=0
bash -euo pipefail > /tmp/sp-test.log 2>&1 <<'EOF' || rc=$?
./build.sh --host
mkdir -p /tmp/sp-scenarios /tmp/l8-scenarios
for s in tests/scenarios_sprout/*.xy; do app/build/host/sprout_host "$s" /tmp/sp-scenarios; done
# LOOM-8's own scenarios, on the same build with SMALL AXE's workshop open from the start (SPROUT_SHOP=1)
# (samples.xy and upload.xy need the user bank tests/run_tests.sh makes: the bank is LOOM-8's, unchanged;
# bluetooth.xy connects to Bluetooth MIDI devices, which SPROUT builds without: fm1.toml ble_central)
for s in tests/scenarios/*.xy; do case "$s" in */samples.xy|*/upload.xy|*/bluetooth.xy) continue;; esac; SPROUT_SHOP=1 app/build/host/sprout_host "$s" /tmp/l8-scenarios > /tmp/l8-one.log 2>&1 || { cat /tmp/l8-one.log; echo "FAILED: $s"; exit 1; }; done
EOF
cat /tmp/sp-test.log
if [ "$rc" != 0 ]; then
  echo "::error title=Tests failed::$(tail -n 60 /tmp/sp-test.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

