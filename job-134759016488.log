2026-11-18T11:08:35.0955721Z Uses: zvenson/fm1-build/.github/workflows/build.yml@refs/tags/v1 (5ba8c359b1744cc53c4530b15eff52d0d5c1255b)
2026-11-18T11:08:35.0959054Z ##[group] Inputs
2026-11-18T11:08:35.0964634Z   build: rc=0
bash -euo pipefail > /tmp/l8-build.log 2>&1 <<'EOF' || rc=$?
# the builder checks out without submodules: fm1-base (base/) and its felucca-bsp (base/bsp/), at the
# commits this one links (.gitmodules: the forks)
git submodule update --init --recursive
# the fonts' OpenType features (base/tools/gen_font.py): Pillow's raqm, which loads the system's FriBiDi
# (as LOOM-8's own release.yml)
sudo apt-get install -y -qq libfribidi0
python3 -c "from PIL import features; assert features.check('raqm'), 'Pillow without raqm'"
if [[ "$GITHUB_REF" == refs/tags/loom8-v* ]]; then rel=(--release "${GITHUB_REF_NAME#loom8-v}"); else rel=(); fi
BOARD=smk37 ./build.sh "${rel[@]}"
# the Pro image's functions by address, into the log (the ci-log branch keeps it): a crash's pc and rets
# (fm1_remote.py log) looked up against the build that crashed
python3 tools/elf_funcs.py "$(ls app/build/*.elf | head -1)" || true
# no radio on the SMK-37 yet: a build with Bluetooth in it stops here
if grep -E '^parts ' /tmp/l8-build.log | tail -1 | sed 's/(not built in.*//' | grep -q Bluetooth; then
  echo "the SMK-37 build has Bluetooth in it: it must not"; exit 1; fi
BOARD=smk37 MODEL=elite ./build.sh "${rel[@]}"
BOARD=smk37 MODEL=mke ./build.sh "${rel[@]}"
# the download: the three packages, the installer and the backup tool, and a note on where to start
mkdir -p build/loom8
cp app/build/*-smk37*.fwsc base/tools/fm1_install.py base/tools/fm1ports.py tools/smk37_backup.py tools/smk37_rescue.py \
  base/tools/fm1_remote.py tools/START-HERE.txt build/loom8/
# (the tools as they sit in the download, nothing else beside them: each must start)
(cd build/loom8 && PYTHONDONTWRITEBYTECODE=1 python3 fm1_install.py --help > /dev/null && PYTHONDONTWRITEBYTECODE=1 python3 smk37_backup.py --help > /dev/null && PYTHONDONTWRITEBYTECODE=1 python3 smk37_rescue.py --help > /dev/null && rm -rf __pycache__)
EOF
cat /tmp/l8-build.log
# the sizes as a note on the run's page (the image against the SMK-37's app slot, 619,520 B; the factory
# samples), readable where the full log isn't
grep -E "image [0-9]+ B; RAM|^samples: " /tmp/l8-build.log | while read -r l; do
  echo "::notice title=Size::$l"
done || true
if [ "$rc" != 0 ]; then
  echo "::error title=Build failed::$(tail -n 60 /tmp/l8-build.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

2026-11-18T11:08:35.0970406Z   packages: build/loom8/*
2026-11-18T11:08:35.0972303Z   test: rc=0
bash -euo pipefail > /tmp/l8-test.log 2>&1 <<'EOF' || rc=$?
BOARD=smk37 ./build.sh --host
mkdir -p /tmp/l8-scenarios
sh tests/make_smk37_bank.sh > /dev/null   # (smk37_bank.xy's banks: the 180 KB filled, one made for 144 KB)
for s in tests/scenarios_smk37/*.xy; do app/build/host/*-smk37_host "$s" /tmp/l8-scenarios; done
cc -std=c99 -Wall -Wno-unused-function -o /tmp/smk_daw_test tests/smk_daw_test.c
/tmp/smk_daw_test
cc -std=c99 -Wall -Wno-unused-function -o /tmp/smk_mcu_test tests/smk_mcu_test.c
/tmp/smk_mcu_test
python3 tests/smk37_backup_test.py
python3 tests/smk37_rescue_test.py
EOF
cat /tmp/l8-test.log
if [ "$rc" != 0 ]; then
  echo "::error title=Tests failed::$(tail -n 60 /tmp/l8-test.log | sed 's/%/%25/g; s/\r//g' | awk '{printf "%s%%0A", $0}')"
  exit "$rc"
fi

