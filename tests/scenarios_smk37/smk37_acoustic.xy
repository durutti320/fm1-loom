# SPIDER's acoustic kit, "acoustic" (tools/gen_kits.py; its samples VCSL's, CC0: tools/prep_acoustic.py, built in after the
# user slots, dsp/sample.c SMP_XTRA): a new project's T1; its eleven keys on the sample model, samples 48.. (16 factory,
# 32 user before them), each sounding; the kit's key on the screen named for its sample
wait 300
expect par1.engine 8
expect par1.d1.model 10
expect par1.d1.k1 48
expect par1.d11.k1 58
expect par1.d3.mode 3
expect par1.d4.mode 3
peakreset
play 1 1 on 100
wait 30
play 1 1 off
wait 500
expect peak_db_min -40
expect peak_db_max -12
peakreset
play 1 2 on 100
wait 30
play 1 2 off
wait 500
expect peak_db_min -40
expect peak_db_max -12
peakreset
play 1 3 on 100
wait 30
play 1 3 off
wait 500
expect peak_db_min -40
expect peak_db_max -12
