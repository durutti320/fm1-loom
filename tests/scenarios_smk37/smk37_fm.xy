# T4, fm (dsp/fm_spider.c): its presets step the patch (K4, PRESETS: each fm preset is its patch's number), a held
# chord stays inside a track's six voices, every patch sounds, and the sound is kept through a save and a restart
wait 300
turn ALGO 3
wait 200
expect par4.0 3
expect par4.e1 0
tap EDIT
wait 100
turn PRESET 3
wait 200
expect par4.e1 3
# ten keys held: six voices at most (NVOICE_TRK), the oldest taken
wav fm_chord.wav
key 0 down 100
key 2 down 100
key 4 down 100
key 5 down 100
key 7 down 100
key 9 down 100
key 11 down 100
key 12 down 100
key 14 down 100
key 16 down 100
wait 300
expect voices <7
expect voices >3
key 0 up
key 2 up
key 4 up
key 5 up
key 7 up
key 9 up
key 11 up
key 12 up
key 14 up
key 16 up
wait 3000
wavstop
expect voices 0
# every patch: a note, then quiet again (the operators' envelopes end the voice)
param 4 e1 0
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 1
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 2
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 3
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 4
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 5
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 6
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 7
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 8
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 9
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 10
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 11
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 12
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 13
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 14
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 15
wait 50
tapkey 12
wait 2500
expect voices 0
param 4 e1 3
wait 100
# kept through a save and a restart
tap SAVE
wait 200
reboot
wait 400
expect par4.0 3
expect par4.e1 3
