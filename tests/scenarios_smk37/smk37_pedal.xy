# the pedal jack (Setup's PEDAL): SUSTAIN holds the keys' notes while it is down; PLAY / STOP; an expression pedal
# (WAH: the played track's cutoff) only once LEARN PEDAL has its heel and toe (any direction); kept in flash; DAW mode
# sends CC 64 / CC 11
wait 300
listen
expect pedalset 0
turn ALGO 2
wait 40
expect trk 3
tap GLO
wait 40
turn SELECT 5
wait 40
expect page Setup
tap SEL
row PEDAL
turn ALGO 1
tap SEL
wait 40
expect pedalset 10000000
wait 800
# SUSTAIN: a key let go while the pedal is down still sounds; the pedal up lets it go
pedal 0
wait 60
key 5 down
wait 100
key 5 up
wait 300
expect voices >0
pedal 1023
wait 60
wait 2500
expect voices 0
# PLAY / STOP: each press of the pedal
tap SEL
row PEDAL
turn ALGO 1
tap SEL
wait 100
pedal 0
wait 60
expect playing 1
pedal 1023
wait 60
expect playing 1
pedal 0
wait 60
expect playing 0
pedal 1023
wait 60
# WAH: not learned yet, a move says so
tap SEL
row PEDAL
turn ALGO 1
tap SEL
wait 100
pedal 900
wait 200
said LEARN PEDAL first
# LEARN PEDAL: heel (900), then toe (100): this pedal reads backwards, as one might
tap SEL
row LEARN PEDAL
tap SEL
wait 40
said heel down
wait 2700
said toe down
pedal 100
wait 2700
said PEDAL learned: heel
expect pedalset 39010101
# halfway: the cutoff halfway
pedal 500
wait 200
expect par3.cut >60
expect par3.cut <68
said wah
pedal 900
wait 200
expect par3.cut 0
# kept: after a restart, the same
wait 2000
reboot
wait 500
expect pedalset 39010101
# DAW mode: CC 11 on channel 1 as it moves
smkbtn < down
smkbtn > down
wait 60
smkbtn > up
smkbtn < up
wait 60
expect daw 1
out
pedal 100
wait 200
wait 200
expect_out USB B0 0B 7F
