# LOOM-8 on the M-VAVE SMK-37 (app/smk37.c): < > the bars, KNOB BANK the pads' job, the mod wheel the filter; DAW
# mode (< + >): the keys, knobs, faders, pads, buttons and wheels as USB MIDI (the DEFAULT map: SMK37.md), LOCAL,
# the settings under PATCH, the map editor, kept in flash (the mode too)
wait 300
expect trk 1
tap SEQ
expect page Steps
# < >: the bar before / after (when let go)
expect bar 1
smktap >
wait 40
expect bar 2
smktap <
wait 40
expect bar 1
# KNOB BANK on Steps: the pads drum pads (a pad writes no step), again: the cells
smktap KNOBBANK
wait 40
expect pads_drums 1
expect drumhits 0
tappad 2 90
expect drumhits 1
expect note 1 1 3 0
smktap KNOBBANK
wait 40
expect pads_drums 0
tappad 2
expect note 1 1 3 3
tappad 2
expect note 1 1 3 0
# KNOB BANK elsewhere: the Steps page, its cells on the pads
tap HOME
expect page Arrange
smktap KNOBBANK
wait 40
expect page Steps
# the mod wheel: the filter of the track the keys play, once it passes the value it has (a pick-up)
spin ALGO 1
expect trk 2
modw 0
wait 40
modw 127
wait 40
expect par2.cut >120
modw 30
wait 40
expect par2.cut <40
shot smk_synth.png

# DAW mode: < + > together
smkbtn < down
smkbtn > down
wait 60
smkbtn > up
smkbtn < up
wait 60
expect daw 1
out
# the keys: notes on CHANNEL 1, C3 = 48 (F3, the FM-1's first key, is 53)
key 0 down 100
wait 20
expect_out USB 90 35 64
key 0 up
wait 20
expect_out USB 80 35 00
outer 0 90
wait 20
expect_out USB 90 30 5A
outer 0 0
wait 20
# OCT+: an octave up
tap OCT+
key 0 down 100
wait 20
expect_out USB 90 41 64
key 0 up
tap OCT-
wait 20
# K5 (the FM-1's KNOB 1) CC 74, ABSOLUTE; K1 (the volume in LOOM-8) CC 70
spin K1 3
wait 20
expect_out USB B0 4A 03
k1 2
wait 20
expect_out USB B0 46 02
# KNOB BANK: bank B, K5 CC 106
smktap KNOBBANK
wait 20
spin K1 1
wait 20
expect_out USB B0 6A 01
smktap KNOBBANK
wait 20
# the faders CC 20..23
fader 1 100
wait 20
expect_out USB B0 15 64
# the pads: notes on channel 10, pad 9 (bottom left) 36
tappad 8 100
expect_out USB 99 24 64
expect_out USB 89 24 00
pads
# the buttons: SEQ CC 112, > CC 111 (when let go)
tap SEQ
wait 20
expect_out USB B0 70 7F
expect_out USB B0 70 00
smktap >
wait 20
expect_out USB B0 6F 7F
expect_out USB B0 6F 00
# the wheels: pitch bend, mod CC 1
bend 8191
wait 20
expect_out USB E0 7F 7F
bend 0
modw 64
wait 20
expect_out USB B0 01 40
modw 0
wait 20
expect daw 1
shot smk_daw.png
# PATCH tapped: LOCAL (the keys play LOOM-8 too)
expect local 0
expect voices 0
tap HOME
wait 20
expect local 1
key 5 down 100
wait 40
expect voices 1
key 5 up
wait 300
# PATCH held: K5 CHANNEL (LOCAL stays)
press HOME
wait 40
spin K1 1
wait 40
release HOME
wait 20
expect dawch 2
expect local 1
key 0 down 100
wait 20
expect_out USB 91 35 64
key 0 up
wait 20
# the map editor: PATCH held + OCT+; touch FADER 2, K6 its number +5 (CC 26), OCT- done: the USER map in use
press HOME
wait 40
tap OCT+
wait 40
release HOME
wait 20
fader 1 20
wait 20
spin K2 5
wait 20
shot smk_daw_edit.png
tap OCT-
wait 20
expect dawuser 1
out
fader 1 90
wait 20
expect_out USB B1 1A 5A
# kept in flash: the settings, the map, the mode (flags: DAW 1, LOCAL 2, USER 4; CHANNEL 2)
wait 2000
expect dawobj 702
reboot
wait 300
expect daw 1
expect dawch 2
expect dawuser 1
expect local 1
# < + >: LOOM-8 again (and kept so)
smkbtn > down
smkbtn < down
wait 60
smkbtn < up
smkbtn > up
wait 60
expect daw 0
wait 2000
expect dawobj 602
reboot
wait 300
expect daw 0
