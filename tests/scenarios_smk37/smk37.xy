# LOOM-8 on the M-VAVE SMK-37 (BOARD=smk37, app/smk37.c): the pads on Steps are the bar's cells (pads 1-8 the top
# row), every other page mutes and drum pads; the faders the levels of T1-T4 / T5-T8 (FADER BANK); the outer keys more notes
wait 300
expect trk 1
tap SEQ
expect page Steps
tappad 0
expect note 1 1 1 1
tappad 9
expect note 1 1 10 1
tappad 0
expect note 1 1 1 0
pads
tap OCT+
tappad 15
expect note 1 1 32 1
tap OCT-
wait 40
shot smk_steps.png
# away from Steps: pads 1-8 mute T1-T8, pads 9-16 the kit's sounds 1-8 (T1 is the kit: pad 9 its kick)
tap HOME
expect mute 0
tappad 1
expect mute 2
tappad 1
expect mute 0
expect drumhits 0
tappad 8 90
expect drumhits 1
pads
# > held: the pads fire the throws on the whole mix, while held; > let go after one: no bar step
smkbtn > down
wait 40
pad 1 100
wait 40
expect punch_drum >0
expect punch_mel >0
pads
pad 1 0
wait 40
expect punch_drum 0
expect punch_mel 0
smkbtn > up
wait 40
expect bar 1
spin ALGO 1
expect trk 2
# faders: T1-T4, then FADER BANK: T5-T8; a fader acts once it moves
fader 0 127
expect par1.level 127
fader 0 0
expect par1.level 0
smktap FADERBANK
fader 0 64
expect par1.level 0
fader 0 100
expect par5.level 100
expect par1.level 0
pads
# outer keys: notes on the track the keys play
expect voices 0
outer 7 100
wait 40
expect voices 1
outer 7 0
wait 200
expect voices 0
outer 1 100
wait 40
expect voices 1
outer 1 0
wait 200
bend 4000
wait 40
bend 0
# on Steps, > held: the pads are the throws there too, and a throw held is never a held step
spin ALGO -1
expect trk 1
tap SEQ
expect page Steps
expect note 1 1 1 0
smkbtn > down
wait 40
pad 0 100
wait 60
expect punch_drum >0
expect note 1 1 1 0
pads
pad 0 0
wait 40
expect punch_drum 0
tappad 4
wait 40
expect punch_drum 0
smkbtn > up
wait 60
expect note 1 1 1 0
expect note 1 1 5 0
# into DAW mode with a throw held: it ends
smkbtn > down
wait 40
pad 2 100
wait 40
expect punch_drum >0
smkbtn < down
wait 60
expect daw 1
expect punch_drum 0
pad 2 0
smkbtn < up
smkbtn > up
wait 60
